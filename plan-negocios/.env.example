# --- Búsqueda web gratuita (resumen de actividad y sitio web) ---
# Google Programmable Search (Custom Search JSON API): gratis hasta 100
# búsquedas por día. Ver el README para el paso a paso de cómo sacar estos
# dos datos. Si no se configuran, esos campos se cargan a mano.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# --- Base de importaciones (Excel "BASE ANA IMPO filtrada 2024 Y 2025 OK") ---
# Hoja con columnas: CUIT, Razon Social, FOB 2025, FOB 2024.
# Default: data/base_ana_impo_2024_2025.xlsx dentro del proyecto.
BASE_IMPO_XLSX=

# --- Envío del plan por mail ---
# Destinatarios fijos (separados por ";"). Si no se define, usa la lista
# del equipo COMEX ya configurada en app/config.py.
MAIL_DESTINATARIOS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=plan-negocios@bind.com.ar
SMTP_STARTTLS=true
