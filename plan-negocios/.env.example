# --- API de Claude (enriquecimiento: razón social, resumen, web, importaciones) ---
# Si no se configura, la app funciona igual pero los datos se cargan a mano.
ANTHROPIC_API_KEY=

# Modelo a usar para la búsqueda web (opcional)
CLAUDE_MODEL=claude-opus-5

# --- Fuente de datos de importaciones (opcional) ---
# Endpoint interno/proveedor (ej. NOSIS, datos propios del banco) que devuelva JSON:
#   GET {IMPORTS_API_URL}?cuit=30XXXXXXXXX  ->  {"2024": 1234567.0, "2025": 2345678.0}
# El header Authorization se arma como "Bearer {IMPORTS_API_TOKEN}" si hay token.
IMPORTS_API_URL=
IMPORTS_API_TOKEN=

# --- SMTP para el envío del PDF por mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=plan-negocios@bind.com.ar
SMTP_STARTTLS=true
