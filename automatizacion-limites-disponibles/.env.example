# Credenciales de Qlik Sense (bi.somosbind.com.ar)
# El sitio usa autenticación Windows (dominio INDUSTRIAL). Probar primero
# con el usuario solo; si da 401, usar el formato con dominio:
#   QLIK_USER=INDUSTRIAL\tu_usuario
QLIK_USER=tu_usuario
QLIK_PASS=tu_contraseña

# La autenticación contra Google Sheets se configura en config.yaml
# (google_sheets.auth). Por defecto usa OAuth con tu propia cuenta:
# solo hace falta el archivo client_secret.json en esta carpeta.

# Contraseña de aplicación de Gmail (16 caracteres) para el envío de
# notificaciones. El resto de la config de mail está en config.yaml.
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
